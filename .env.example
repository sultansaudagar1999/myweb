# Copy to .env.local for local builds. In GitHub, add these as repository
# Variables (Settings → Secrets and variables → Actions → Variables).

# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://sultansaudagar1999.github.io

# Leave empty for a user site (username.github.io). For a project repo use /repo-name.
NEXT_PUBLIC_BASE_PATH=

# Web3Forms access key (free at https://web3forms.com). This key is designed to be
# public: it can only deliver submissions to the email address it was created for.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics load only when set.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=
